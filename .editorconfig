root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown 行尾双空格是硬换行语义，不能裁掉
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

[*.kts]
indent_size = 4
